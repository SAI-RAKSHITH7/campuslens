# ==========================================
# CampusLens Environment Configuration
# ==========================================
# IMPORTANT: This is an example file with placeholder values only.
# Never commit actual secret keys or your production .env to version control!

# ------------------------------------------
# Backend Settings (Render / Local Server)
# ------------------------------------------
# Required: API key for hosted Gemma 4 from Google AI Studio / Google Gen AI API
# In Render, add this under Dashboard -> Service -> Environment -> GEMMA_API_KEY
GEMMA_API_KEY=your_hosted_gemma_api_key_here

# Optional: Hosted Gemma multimodal model identifier (defaults to gemma-4-31b-it)
# Supported options: gemma-4-31b-it, gemma-4-26b-a4b-it
GEMMA_MODEL=gemma-4-31b-it

# Allowed CORS origins (comma-separated). Set your production Vercel frontend URL here.
# Note: https://*.vercel.app is also automatically permitted by backend regex.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-campuslens-app.vercel.app

# Server Port (Render sets this dynamically via $PORT)
PORT=8000

# ------------------------------------------
# Frontend Settings (Vercel / Local Vite)
# ------------------------------------------
# In Vercel, add this under Project Settings -> Environment Variables -> VITE_API_BASE_URL
# Local dev: http://localhost:8000
# Production: https://campuslens-api.onrender.com (replace with your Render backend URL)
VITE_API_BASE_URL=http://localhost:8000
